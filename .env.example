# ============================================================
# Marketing OS — Environment Variables
# Copy to .env and fill in real values
# ============================================================

# --- LLM ---
GROQ_API_KEY=

# --- Scraping ---
APIFY_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://marketing_os:marketing_os_pass@localhost:5432/marketing_os
DATABASE_URL_SYNC=postgresql://marketing_os:marketing_os_pass@localhost:5432/marketing_os

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# --- Service Ports ---
INTAKE_SERVICE_PORT=8001
SCRAPER_SERVICE_PORT=8002
INTELLIGENCE_SERVICE_PORT=8003
POSITIONING_SERVICE_PORT=8004
ICP_SERVICE_PORT=8005
EMBEDDING_SERVICE_PORT=8006
CAMPAIGN_CONTEXT_SERVICE_PORT=8007
ORCHESTRATOR_PORT=8008
NOTIFICATION_SERVICE_PORT=8009

# --- Postgres (for docker-compose) ---
POSTGRES_DB=marketing_os
POSTGRES_USER=marketing_os
POSTGRES_PASSWORD=marketing_os_pass
